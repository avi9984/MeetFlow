// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventTypes             EventType[]
  availabilities         AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  slots                  Slot[]

  @@map("users")
}

model EventType {
  id                  Int      @id @default(autoincrement())
  hostId              Int
  title               String
  slug                String
  description         String?
  durationMinutes     Int
  isActive            Boolean  @default(true)
  locationType        String   @default("Online")
  locationValue       String?
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  host  User   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  slots Slot[]

  @@unique([hostId, slug])
  @@map("event_type")
}

model AvailabilityRule {
  id        Int      @id @default(autoincrement())
  userId    Int
  weekday   Int
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday])
  @@map("availability_rules")
}

model AvailabilityException {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  type      String
  startTime String?
  endTime   String?
  timezone  String   @default("UTC")
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("availability_exceptions")
}

model Slot {
  id          Int      @id @default(autoincrement())
  hostId      Int
  eventTypeId Int
  startAt     DateTime
  endAt       DateTime
  status      String   @default("AVAILABLE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@unique([eventTypeId, startAt, endAt])
  @@index([hostId, startAt])
  @@index([eventTypeId, startAt, status])
  @@map("slots")
}
